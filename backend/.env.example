# Copy to .env for local (non-Docker) development.
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Use host.docker.internal or the compose service names when running in Docker.
MONGO_URI=mongodb://127.0.0.1:27017/nova_commerce
REDIS_URL=redis://127.0.0.1:6379

# Generate real secrets for anything other than local development:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_REFRESH_TTL_SECONDS=2592000

# Cache lifetimes in seconds.
CACHE_PRODUCT_LIST_TTL=120
CACHE_PRODUCT_DETAIL_TTL=300
CACHE_FILTER_TTL=600
CACHE_SUGGEST_TTL=60

RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=300
RATE_LIMIT_AUTH_MAX=12

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

TAX_RATE=0.08
FREE_SHIPPING_THRESHOLD=100
STANDARD_SHIPPING_FEE=9.99
EXPRESS_SHIPPING_FEE=24.99
