{
  "name": "nova-commerce-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "REST API for the Nova storefront — Express, MongoDB and Redis.",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:fresh": "node src/seed/seed.js --drop",
    "catalogue:fetch": "node src/scripts/fetch-catalogue.mjs",
    "smoke": "node src/scripts/smoke-api.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.0",
    "morgan": "^1.10.1",
    "nodemon": "^3.1.14",
    "zod": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
